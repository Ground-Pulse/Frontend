# Copy to .env.local for local dev. On Vercel, set these under
# Project → Settings → Environment Variables.

# "true" = built-in mock API (no backend needed). "false" = call the real API.
NEXT_PUBLIC_USE_MOCK_API=false

# NestJS backend (Render): https://<your-service>.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
